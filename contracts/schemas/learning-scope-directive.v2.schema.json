{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstituteLearningScopeDirectiveV2",
  "description": "PROPOSED_NON_CANONICAL; explicit target language, regional variant, instruction locale and curriculum version. Backward compatible v1 data requires an approved migration before real deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "directiveId",
    "tenantId",
    "studentId",
    "teacherId",
    "programId",
    "version",
    "allowedTopics",
    "excludedTopics",
    "allowedActivityTypes",
    "maxSessionMinutes",
    "startsAt",
    "expiresAt",
    "status",
    "targetLanguageCode",
    "localeVariant",
    "instructionLocale",
    "programVersion"
  ],
  "properties": {
    "directiveId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "studentId": {
      "type": "string",
      "minLength": 1
    },
    "teacherId": {
      "type": "string",
      "minLength": 1
    },
    "programId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 2
    },
    "allowedTopics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excludedTopics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedActivityTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxSessionMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "startsAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "revoked"
      ]
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1
    },
    "revokedAt": {
      "type": "string",
      "format": "date-time"
    },
    "targetLanguageCode": {
      "type": "string",
      "minLength": 2
    },
    "localeVariant": {
      "type": "string",
      "minLength": 2
    },
    "instructionLocale": {
      "type": "string",
      "minLength": 2
    },
    "programVersion": {
      "type": "string",
      "minLength": 1
    }
  }
}
