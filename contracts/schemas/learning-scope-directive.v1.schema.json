{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.elyora.example/institute/learning-scope-directive.v1.schema.json",
  "title": "InstituteLearningScopeDirectiveV1",
  "description": "PROPOSED_NON_CANONICAL institute policy object, not an ELYORA assessment contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "directiveId",
    "tenantId",
    "studentId",
    "teacherId",
    "programId",
    "version",
    "allowedTopics",
    "excludedTopics",
    "allowedActivityTypes",
    "maxSessionMinutes",
    "startsAt",
    "expiresAt",
    "status"
  ],
  "properties": {
    "directiveId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "studentId": {
      "type": "string",
      "minLength": 1
    },
    "teacherId": {
      "type": "string",
      "minLength": 1
    },
    "programId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "allowedTopics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excludedTopics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedActivityTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxSessionMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "startsAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "revoked"
      ]
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1
    },
    "revokedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
