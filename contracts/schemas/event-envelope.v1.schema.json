{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstituteEventEnvelopeV1",
  "description": "PROPOSED_NON_CANONICAL durable facts only; not source of truth by themselves.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "tenantId",
    "actorId",
    "subjectId",
    "correlationId",
    "classification",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "actorId": {
      "type": "string",
      "minLength": 1
    },
    "subjectId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "classification": {
      "enum": [
        "operational",
        "student_private",
        "teacher_private",
        "institution_confidential",
        "aggregate"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
